#!/bin/bash
# Pre-commit hook for main-apiary's own checkout. Runs every check and blocks
# the commit if any of them fail.
#
#   1. docs/check.py            — framework-doc conformance
#   2. docs/check_cli_claims.py — cli-tools.md vs each tool's real argparse
#   3. scripts/secret_scan.py --staged — credentials in the staged diff
#
# All three run even when an earlier one fails, so one commit attempt reports
# every problem instead of making you re-run to discover the next one.
#
# check_cli_claims.py shells out to ~44 tools' `--help` and takes ~15-20 s —
# by far the slowest of the three. It runs here rather than only at push
# because `core/hooks/pre_push_doc_conformer.py` blocks the push on the same
# check, and a doc edit is a much cheaper fix at commit time than a blocked
# push with several commits already stacked behind it.
#
# Installed by: python scripts/install_repo_hooks.py
# Source: docs/hooks/pre-commit

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve from git, not from the hook file location: in a linked worktree the
# hook lives in the COMMON git dir, so a path-relative root would be the main
# checkout and every check (including the secret scan) would run against the
# wrong tree.
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Resolve a Python 3 interpreter portably. No single name works everywhere:
# Windows ships the `py` launcher, Unix ships `python3`, some boxes only have
# `python`. Override with $APIARY_PYTHON (absolute path or command name);
# otherwise probe each candidate and verify it is actually Python 3.
_is_py3() { "$@" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' >/dev/null 2>&1; }
if [ -n "$APIARY_PYTHON" ]; then
    PY=("$APIARY_PYTHON")
elif command -v py      >/dev/null 2>&1 && _is_py3 py -3;   then PY=(py -3)
elif command -v python3 >/dev/null 2>&1 && _is_py3 python3; then PY=(python3)
elif command -v python  >/dev/null 2>&1 && _is_py3 python;  then PY=(python)
else
    echo "pre-commit: no Python 3 found — set APIARY_PYTHON to your interpreter" >&2
    exit 1
fi

STATUS=0

"${PY[@]}" "$REPO_ROOT/docs/check.py"            || STATUS=1
"${PY[@]}" "$REPO_ROOT/docs/check_cli_claims.py" || STATUS=1
"${PY[@]}" "$REPO_ROOT/scripts/secret_scan.py" --staged --quiet || STATUS=1

exit $STATUS
