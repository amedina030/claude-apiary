#!/bin/bash
# Pre-commit hook for main-apiary's own checkout. Runs every check and blocks
# the commit if any of them fail.
#
#   1. docs/check.py            — framework-doc conformance
#   2. docs/check_cli_claims.py — cli-tools.md vs each tool's real argparse
#   3. scripts/secret_scan.py --staged — credentials in the staged diff
#   4. ruff check — lint, on the staged .py files only
#
# The change-map check (docs/change_map.py) is NOT here: it needs the
# commit message to honour the `docs: unchanged` trailer, and git only
# writes the message after pre-commit — it runs in docs/hooks/commit-msg.
#
# All four run even when an earlier one fails, so one commit attempt reports
# every problem instead of making you re-run to discover the next one.
#
# 2-4 all shell out to every tool's `--help`. They share an on-disk cache keyed
# by a fingerprint of the tree (see check_cli_claims._repo_fingerprint), so the
# first one pays ~9 s and the rest are ~0.3 s. The checks run here rather than
# only at push because `core/hooks/pre_push_doc_conformer.py` blocks the push
# on the same check, and a doc edit is a much cheaper fix at commit time than a
# blocked push with several commits already stacked behind it.
#
# Anything 3 or 4 reports is fixed by re-running the same command with --write.
#
# 5 waives on APIARY_DOCS_UNCHANGED=1 here rather than on the `docs: unchanged`
# trailer, because git has not written this commit's message yet at pre-commit
# time — the trailer route lives in `docs/hooks/commit-msg`.
#
# Installed by: python scripts/install_repo_hooks.py
# Source: docs/hooks/pre-commit

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Resolve from git, not from the hook file location: in a linked worktree the
# hook lives in the COMMON git dir, so a path-relative root would be the main
# checkout and every check (including the secret scan) would run against the
# wrong tree.
REPO_ROOT="$(git rev-parse --show-toplevel)"
# Main checkout root. In a linked worktree (the runner works in
# .runner-worktrees/*) the toplevel has no .venv, but the main checkout's
# does -- git-common-dir points at the main .git, whose parent is the main
# checkout. Equal to REPO_ROOT outside a worktree; on gits too old for
# --path-format the dirname of the relative path is just '.', and the venv
# probes below fail closed to the PATH fallbacks.
MAIN_ROOT="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)")"

# Resolve a Python 3 interpreter portably. No single name works everywhere:
# Windows ships the `py` launcher, Unix ships `python3`, some boxes only have
# `python`. Override with $APIARY_PYTHON (absolute path or command name);
# otherwise probe each candidate and verify it is actually Python 3.
_is_py3() { "$@" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' >/dev/null 2>&1; }
if [ -n "$APIARY_PYTHON" ]; then
    PY=("$APIARY_PYTHON")
# The main checkout's venv first: it is the interpreter with the dev group
# (ruff) installed, and unlike a worktree-local venv it is never mid-install.
# (Retry 2026-08-31: a step agent ran `poetry install` inside the runner's
# worktree; the hook picked that venv up seconds after its creation and the
# generated-doc check reported phantom drift.) Outside a worktree MAIN_ROOT
# equals REPO_ROOT, so this is the historical "repo venv first" order there.
elif [ -x "$MAIN_ROOT/.venv/Scripts/python.exe" ]; then PY=("$MAIN_ROOT/.venv/Scripts/python.exe")
elif [ -x "$MAIN_ROOT/.venv/bin/python" ];         then PY=("$MAIN_ROOT/.venv/bin/python")
elif [ -x "$REPO_ROOT/.venv/Scripts/python.exe" ]; then PY=("$REPO_ROOT/.venv/Scripts/python.exe")
elif [ -x "$REPO_ROOT/.venv/bin/python" ];         then PY=("$REPO_ROOT/.venv/bin/python")
elif command -v py      >/dev/null 2>&1 && _is_py3 py -3;   then PY=(py -3)
elif command -v python3 >/dev/null 2>&1 && _is_py3 python3; then PY=(python3)
elif command -v python  >/dev/null 2>&1 && _is_py3 python;  then PY=(python)
else
    echo "pre-commit: no Python 3 found — set APIARY_PYTHON to your interpreter" >&2
    exit 1
fi

# Resolve ruff the same way: an explicit $APIARY_RUFF, then the PATH, then the
# dev-group install inside whatever interpreter we just found.
if [ -n "$APIARY_RUFF" ]; then
    RUFF=("$APIARY_RUFF")
elif command -v ruff >/dev/null 2>&1; then
    RUFF=(ruff)
elif "${PY[@]}" -c 'import ruff' >/dev/null 2>&1; then
    RUFF=("${PY[@]}" -m ruff)
# A stray worktree venv may satisfy the PY probe yet lack ruff -- fall
# through to the venv ruff executables, main checkout first (stable,
# complete install), then the worktree's.
elif [ -x "$MAIN_ROOT/.venv/Scripts/ruff.exe" ]; then
    RUFF=("$MAIN_ROOT/.venv/Scripts/ruff.exe")
elif [ -x "$MAIN_ROOT/.venv/bin/ruff" ]; then
    RUFF=("$MAIN_ROOT/.venv/bin/ruff")
elif [ -x "$REPO_ROOT/.venv/Scripts/ruff.exe" ]; then
    RUFF=("$REPO_ROOT/.venv/Scripts/ruff.exe")
elif [ -x "$REPO_ROOT/.venv/bin/ruff" ]; then
    RUFF=("$REPO_ROOT/.venv/bin/ruff")
else
    RUFF=()
fi

STATUS=0

"${PY[@]}" "$REPO_ROOT/docs/check.py"                        || STATUS=1
"${PY[@]}" "$REPO_ROOT/docs/check_cli_claims.py"             || STATUS=1
"${PY[@]}" "$REPO_ROOT/docs/generate_cli_docs.py"  --check   || STATUS=1
"${PY[@]}" "$REPO_ROOT/docs/generate_reference.py" --check   || STATUS=1
"${PY[@]}" "$REPO_ROOT/scripts/secret_scan.py" --staged --quiet || STATUS=1

# Lint only the staged .py files — a whole-tree `ruff check` is still fast, but
# this keeps the hook from failing a commit on a file the author never touched.
# `--force-exclude` makes ruff honour pyproject's `exclude` for paths handed to
# it explicitly (without it, an excluded path passed by name is still linted).
# No `ruff format --check` here: CI gates formatting, and a hook that rejects a
# commit over whitespace is a hook people learn to --no-verify.
STAGED_PY="$(git diff --cached --name-only --diff-filter=ACMR -- '*.py')"
if [ -n "$STAGED_PY" ]; then
    if [ ${#RUFF[@]} -gt 0 ]; then
        # -z/xargs -0 rather than the newline list above: git quotes paths with
        # spaces or non-ASCII in its normal output, and a quoted path is not a
        # path. The emptiness test above is what keeps a zero-length list from
        # reaching xargs, which would otherwise run ruff over the whole tree.
        (
            cd "$REPO_ROOT" || exit 1
            git diff --cached --name-only --diff-filter=ACMR -z -- '*.py' \
                | xargs -0 "${RUFF[@]}" check --force-exclude
        ) || STATUS=1
    else
        echo "pre-commit: ruff not found, skipping lint (poetry install, or set \$APIARY_RUFF)" >&2
    fi
fi

exit $STATUS
