#!/bin/bash
# Pre-commit hook for an apiary-managed repo that is NOT main-apiary.
# Blocks the commit when the staged diff contains something credential-shaped.
#
# Installed by: python .claude/apiary/launch.py scripts/install_git_hooks.py
# Source: docs/hooks/pre-commit-secret-scan
#
# This resolves main-apiary through the per-repo launcher's --print-repo-path
# and then invokes the scanner DIRECTLY, rather than running it through
# launch.py. The launcher deliberately exits 0 when main-apiary is unreachable
# (a Claude Code hook must never block a tool call) — but for a secret scan
# that would fail open and silently wave a leak through. A security control
# that quietly stops working is worse than one that is loudly broken, so this
# fails closed and prints exactly how to proceed.

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [ -z "$REPO_ROOT" ]; then
    echo "secret-scan: not inside a git repository" >&2
    exit 1
fi

_is_py3() { "$@" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' >/dev/null 2>&1; }
if [ -n "$APIARY_PYTHON" ]; then
    PY=("$APIARY_PYTHON")
elif command -v py      >/dev/null 2>&1 && _is_py3 py -3;   then PY=(py -3)
elif command -v python3 >/dev/null 2>&1 && _is_py3 python3; then PY=(python3)
elif command -v python  >/dev/null 2>&1 && _is_py3 python;  then PY=(python)
else
    echo "secret-scan: no Python 3 found — set APIARY_PYTHON to your interpreter" >&2
    exit 1
fi

LAUNCHER="$REPO_ROOT/.claude/apiary/launch.py"
if [ ! -f "$LAUNCHER" ]; then
    echo "secret-scan: launcher missing at .claude/apiary/launch.py" >&2
    echo "  This repo is not apiary-managed (or the install is broken)." >&2
    echo "  Re-install, or bypass once with: git commit --no-verify" >&2
    exit 1
fi

MAIN_APIARY="$("${PY[@]}" "$LAUNCHER" --print-repo-path 2>/dev/null)"
SCANNER="$MAIN_APIARY/scripts/secret_scan.py"
if [ -z "$MAIN_APIARY" ] || [ ! -f "$SCANNER" ]; then
    echo "secret-scan: cannot reach main-apiary — the scan did NOT run." >&2
    echo "  Fix the pointer in .claude/apiary/, or bypass once with:" >&2
    echo "    git commit --no-verify" >&2
    exit 1
fi

"${PY[@]}" "$SCANNER" --staged --quiet
exit $?
