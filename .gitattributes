# Normalize on the way in: whatever a clone's core.autocrlf says, text files
# are stored LF in the index. Without this a Windows clone with
# core.autocrlf=false commits CRLF and every POSIX consumer inherits it
# (review subsystems/infra-docs-skills.md §1 "Line endings").
* text=auto

# Shell scripts must keep LF line endings so they run on macOS/Linux even when
# cloned on a machine with core.autocrlf=true. A CRLF shebang breaks execution
# (`/usr/bin/env bash^M: bad interpreter`).
*.sh text eol=lf

# Repo-local git hooks (no extension) are POSIX shell — same requirement.
docs/hooks/* text eol=lf
runner/hooks/* text eol=lf

# Windows-only launchers: keep CRLF in the working tree. PowerShell copes with
# LF, but cmd.exe batch files do not, and the pair should behave the same.
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# Never normalize binaries.
*.ico binary
*.png binary
*.jpg binary
*.gif binary
*.pdf binary
*.zip binary
