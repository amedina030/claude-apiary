{
  "refine": {
    "max_retries": 3,
    "model": "opus",
    "timeout": 900
  },
  "plan": {
    "max_retries": 3,
    "model": "opus",
    "timeout": 900
  },
  "executor": {
    "model": "sonnet",
    "max_retries_per_step": 2,
    "max_no_change_retries": 2,
    "timeout": 900,
    "mode": "monolithic"
  },
  "monolithic_executor": {
    "timeout_seconds": 1800
  },
  "harden": {
    "max_rounds": 1,
    "attacker_model": "opus",
    "defender_model": "sonnet",
    "timeout": 300
  },
  "orchestrator": {
    "stage_timeout": 3600
  },
  "detached": {
    "token_cap": 10000000,
    "max_unreviewed": 5,
    "max_restarts": 3
  },
  "runner": {
    "target_repo": null,
    "banned_tokens": {
      "pytest": "use unittest (stdlib) — see docs/standards/code-style.md",
      "shell=true": "shell=True is banned — use list-form subprocess args",
      "import requests": "external dependencies are banned — stdlib only",
      "from requests": "external dependencies are banned — stdlib only"
    },
    "target_overrides": {}
  },
  "usher": {
    "max_files": {"pass": 5, "warn": 8},
    "max_subsystems": {"pass": 2, "warn": 3},
    "max_description_chars": {"pass": 2000, "warn": 4000}
  }
}
