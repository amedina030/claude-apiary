#!/bin/bash
# Post-merge hook: auto-close the scribe TODO linked to a merged runner branch.
#
# Fires after any `git merge` / `git pull` that updates HEAD. The Python
# side walks the merge's second-parent commits looking for a runner/<uuid>
# step subject, looks up run_history.jsonl for that uuid's source TODO,
# and marks it done. Silent no-op when the merge isn't a runner branch.
#
# Installed by: python scripts/install_repo_hooks.py
# Source: runner/hooks/post-merge

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Resolve a Python 3 interpreter portably (see docs/hooks/pre-commit for the
# rationale). Override with $APIARY_PYTHON. This hook is advisory housekeeping,
# so a missing interpreter is a silent no-op — it must never block a merge.
_is_py3() { "$@" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' >/dev/null 2>&1; }
if [ -n "$APIARY_PYTHON" ]; then
    PY=("$APIARY_PYTHON")
elif command -v py      >/dev/null 2>&1 && _is_py3 py -3;   then PY=(py -3)
elif command -v python3 >/dev/null 2>&1 && _is_py3 python3; then PY=(python3)
elif command -v python  >/dev/null 2>&1 && _is_py3 python;  then PY=(python)
else
    exit 0
fi

"${PY[@]}" -m runner.close_source_todo
# Never block the merge; this is advisory housekeeping.
exit 0
