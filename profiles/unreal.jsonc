// Unreal Engine project profile — for repos that run a Claude Code
// session against an Unreal project with the `ue-llm-toolkit` MCP
// server loaded.
//
// Wires the ue_llm_toolkit observer so reader/mutation/screenshot calls
// produced by the MCP server get captured into the target repo's
// .apiary/observer/ JSONL stream.
{
  "$schema_version": 1,
  "extends": ["base"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "mcp__ue_llm_toolkit__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python ~/.claude/apiary_launch.py observers/ue_llm_toolkit.py"
          }
        ]
      }
    ]
  }
}
