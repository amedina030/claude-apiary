// Apiary self-dogfood profile — proves the bootstrap by applying it to
// apiary itself. Currently identical to `base` (just extends it) because
// apiary has no repo-specific additions on top of the baseline
// permissions.
//
// If apiary later grows its own per-repo hooks or permissions that
// don't belong in `base` (the shared minimum for every apiary-managed
// repo), they go here.
{
  "$schema_version": 1,
  "extends": ["base"]
}
