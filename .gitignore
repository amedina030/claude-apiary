__pycache__/
*.pyc
*.pyo

# Budgeter runtime data
budgeter/tmp/
budgeter/data/

# Refiner runtime data
refiner/tmp/

# Harden runtime data
harden/tmp/

# Pipeline runtime artifacts (untracked; live only on disk so branch switches don't move them)
# Use trailing /* not /  — git cannot re-include files inside a fully-excluded directory.
pipeline/specs/*
pipeline/plans/*
pipeline/executions/*
pipeline/hardens/*
pipeline/reports/*
!pipeline/specs/.gitkeep
!pipeline/plans/.gitkeep
!pipeline/executions/.gitkeep
!pipeline/hardens/.gitkeep
!pipeline/reports/.gitkeep
!pipeline/reports/.gitkeep

# Session runtime artifacts
.claude-session-identity.json

# Scribe / clarifier runtime
.claude/notes.md
.claude/clarifier-logs/
.claude/issues.md
