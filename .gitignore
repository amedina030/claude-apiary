__pycache__/
*.pyc
*.pyo
.venv/

# Centralized per-target apiary state (registry + per-target subdirs)
.repos/

# Apiary's own per-target breadcrumb (lives at <target>/.apiary/pointer post-migration)
.apiary/
.apiary.pre-migration/

# Hook forensic logs
core/hooks/*.log

# Budgeter runtime data
budgeter/tmp/
budgeter/data/

# Refiner runtime data
refiner/tmp/

# Harden runtime data
harden/tmp/

# Runner runtime artifacts (untracked; live only on disk so branch switches don't move them)
# Use trailing /* not /  — git cannot re-include files inside a fully-excluded directory.
runner/specs/*
runner/plans/*
runner/executions/*
runner/hardens/*
runner/reports/*
!runner/specs/.gitkeep
!runner/plans/.gitkeep
!runner/executions/.gitkeep
!runner/hardens/.gitkeep
!runner/reports/.gitkeep
!runner/reports/.gitkeep

# Post-mortem / validation reports (docs/standards/report-style.md). These are
# local-only by default; the rare load-bearing report that must be tracked can
# still be added with `git add -f`.
docs/reports/

# Runner runtime logs, history, and crash recovery
runner/logs/
runner/locks/
runner/crashes/
runner/runs/
runner/overnight.jsonl
runner/run_history.jsonl
runner/usher_order.json.lock

# Detached runner worktrees (one per in-flight run)
.runner-worktrees/

# Session runtime artifacts
.claude-session-identity.json
session_*.txt

# Scribe runtime
.claude/notes.md
.claude/issues.md

# GUI PyInstaller build outputs
build/
dist/
.claude/
