__pycache__/
*.pyc
*.pyo

# Hook forensic logs
core/hooks/*.log

# Budgeter runtime data
budgeter/tmp/
budgeter/data/

# Refiner runtime data
refiner/tmp/

# Harden runtime data
harden/tmp/

# Runner runtime artifacts (untracked; live only on disk so branch switches don't move them)
# Use trailing /* not /  — git cannot re-include files inside a fully-excluded directory.
runner/specs/*
runner/plans/*
runner/executions/*
runner/hardens/*
runner/reports/*
!runner/specs/.gitkeep
!runner/plans/.gitkeep
!runner/executions/.gitkeep
!runner/hardens/.gitkeep
!runner/reports/.gitkeep
!runner/reports/.gitkeep

# Session runtime artifacts
.claude-session-identity.json
session_*.txt

# Scribe runtime
.claude/notes.md
.claude/issues.md
